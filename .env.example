# Database (SQLite local; hỗ trợ chuyển sang PostgreSQL trong Prisma schema)
DATABASE_URL="file:./dev.db"

# AI / Anthropic Claude
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
# Đặt LLM_MOCK=1 để chạy chế độ mô phỏng offline không gọi Anthropic API
# LLM_MOCK=1

# Application & Pricing
APP_URL=http://localhost:3000
TAX_RATE=0.1
# DEFAULT_UNIT_PRICE=772917

# Zalo Bot Platform (tùy chọn, dùng cho worker scripts/zalo-bot.ts)
ZALO_BOT_TOKEN=
ACTIVE_CLIENT_TTL_HOURS=2

# Gmail IMAP Sync (tùy chọn, dùng App Password 16 ký tự)
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_SYNC_TAG=[Freevo]
